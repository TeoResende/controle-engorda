# --- Domínios (dev usa *.localhost via Traefik) ---
DOMAIN=localhost
API_HOST=api.localhost
APP_HOST=app.localhost
MINIO_HOST=minio.localhost
TRAEFIK_HTTP_PORT=8081
TRAEFIK_HTTPS_PORT=8443
TRAEFIK_DASHBOARD_PORT=8090
# E-mail para os avisos do Let's Encrypt (expiração de certificado).
ACME_EMAIL=seu-email@exemplo.com

# --- Fuso horário ---
# "Hoje" tem que ser o dia da FAZENDA, não o de Greenwich. Sem isto, o contador
# de pesagens do dia zera às 21h no horário de Brasília, com o técnico ainda no
# curral. Os instantes continuam gravados em UTC (timestamptz); o que muda é a
# interpretação de "hoje".
TZ=America/Sao_Paulo

# --- Postgres ---
POSTGRES_USER=engorda
POSTGRES_PASSWORD=engorda_dev_senha
POSTGRES_DB=engorda
# Papel restrito com que a APLICAÇÃO fala com o banco. É o que faz a Row-Level
# Security valer: superusuário do Postgres ignora políticas de linha, inclusive
# com FORCE. As migrations continuam usando POSTGRES_USER, que precisa de DDL.
POSTGRES_APP_USER=engorda_app
POSTGRES_APP_PASSWORD=engorda_app_dev

# --- Atrás de proxy ---
# Quando o HTTPS termina fora da aplicação (Nginx Proxy Manager, Cloudflare), o
# backend só descobre isso pelo cabeçalho X-Forwarded-Proto. Confira em
# /api/pronto se o proxy está repassando.
#
# "*" só é seguro porque o backend não é alcançável de fora da rede do Docker.
# Se um dia for exposto direto, ponha aqui os IPs reais dos proxies.
PROXIES_CONFIAVEIS=*
# Faixas de IP dos proxies da frente, para o Traefik confiar nos cabeçalhos.
IPS_DO_PROXY=127.0.0.1/32,172.16.0.0/12
# Em produção, liste só o domínio real: CORS_ORIGENS=https://app.suafazenda.com.br
CORS_ORIGENS=*

# Aplica as migrations pendentes ao subir. Deixe 1 para que instalar em outro
# servidor seja `docker compose up` e mais nada; ponha 0 num deploy com várias
# réplicas, onde a migration deve ser um passo controlado.
MIGRAR_AO_SUBIR=1
# Perfil da imagem do backend: "dev" inclui as ferramentas de teste, "api" é a
# imagem enxuta de produção. O worker sempre usa a própria, com a transcrição.
PERFIL_BACKEND=dev
# "producao" faz a aplicação RECUSAR subir com segredo de exemplo e esconde a
# documentação interativa. Use em qualquer ambiente que não seja a sua máquina.
AMBIENTE=desenvolvimento

# --- Backend ---
# UID/GID do host: o backend roda com eles para não criar arquivos root
# no bind mount (migrations geradas pelo Alembic).
UID_HOST=1000
GID_HOST=1000
SECRET_KEY=troque-esta-chave-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30
LOG_LEVEL=info

# --- Transcrição de áudio (M7) ---
# Sem chave, o worker vai direto para o Whisper local. Com chave, tenta a API
# externa primeiro e cai para o local se ela falhar.
TRANSCRICAO_API_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRICAO_API_CHAVE=
TRANSCRICAO_API_MODELO=whisper-1
# small equilibra qualidade e CPU de VPS; tiny cabe em máquina apertada.
WHISPER_MODELO_LOCAL=small

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev
MINIO_BUCKET=observacoes

# --- Frontend ---
# Mesma origem do app (o Traefik roteia /api para o backend). Deixe vazio ou
# use um endereço absoluto só se o frontend for servido de outro domínio.
NEXT_PUBLIC_API_URL=/api
